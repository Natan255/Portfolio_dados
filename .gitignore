@"
# Ambientes virtuais Python
venv/
.venv/
env/

# Cache e arquivos temporários do Python
__pycache__/
*.py[cod]
*$py.class

# Checkpoints do Jupyter Notebook
.ipynb_checkpoints/

# Arquivos de variáveis de ambiente (senhas/credenciais)
.env

# Arquivos de Sistema Operacional
.DS_Store
Thumbs.db
desktop.ini

# Configurações locais de IDE
.vscode/
.idea/
"@ | Out-File -FilePath .gitignore -Encoding utf8